{
  "compilerOptions": {
    "lib": [
      "es2018",
      "dom"
    ],
    "declaration": true,
    "module": "ES2015",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "rootDir": "schematics",
    "outDir": "../../dist/planmonitor-wonen/schematics",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strictNullChecks": true,
    "target": "es6",
    "types": ["node"]
  },
  "include": [
    "./schematics/**/*"
  ],
  "exclude": [
    "./schematics/*/files/**/*"
  ]
}
